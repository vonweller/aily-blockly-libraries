{
  "toolbox_name": "PS2-Gamepad",
  "ps2x_init": {
    "message0": "PS2-Gamepad initialisieren %1 ATT %2 CMD %3 DAT %4 CLK %5",
    "tooltip": "Initialisiert ein PS2-Gamepad (DualShock 2; universelle Bibliothek, Hardware-SPI). ATT ist die Chip-Select-Leitung; auf Kernen mit SPI-Remapping (z. B. ESP32) sind CMD/DAT/CLK beliebige GPIOs, auf Kernen mit festen SPI-Pads (z. B. micro:bit V2) müssen P15(MOSI)/P14(MISO)/P13(SCK) verwendet werden. Referenzverkabelung für den Chuanglebo MakeBit PS2-Sockel: ATT=P12, CMD=P15, DAT=P14, CLK=P13. Im Setup platzieren; danach wird das Gamepad in jeder Schleife automatisch abgefragt."
  },
  "ps2x_connected": {
    "message0": "Gamepad %1 verbunden",
    "tooltip": "Prüft, ob das Gamepad angeschlossen ist und antwortet. Getrennt liefern die Sticks 0 und alle Tasten gelten als losgelassen; nach dem Wiederverbinden wird automatisch neu konfiguriert."
  },
