{
  "toolbox_name": "Controle PS2",
  "ps2x_init": {
    "message0": "inicializar controle PS2 %1 ATT %2 CMD %3 DAT %4 CLK %5",
    "tooltip": "Inicializa um controle PS2 (DualShock 2; biblioteca universal, SPI de hardware). ATT é o chip select; em núcleos com remapeamento SPI (ex.: ESP32) CMD/DAT/CLK podem ser qualquer GPIO, enquanto em núcleos com pinos SPI fixos (ex.: micro:bit V2) devem ser P15(MOSI)/P14(MISO)/P13(SCK). Fiação de referência para o soquete PS2 do Chuanglebo MakeBit: ATT=P12, CMD=P15, DAT=P14, CLK=P13. Coloque na inicialização; o controle é lido automaticamente a cada laço."
  },
  "ps2x_connected": {
    "message0": "controle %1 conectado",
    "tooltip": "Indica se o controle está conectado e respondendo. Desconectado, os analógicos retornam 0 e todos os botões ficam soltos; ao reconectar, é reconfigurado automaticamente."
  },
