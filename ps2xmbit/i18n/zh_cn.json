{
  "toolbox_name": "PS2手柄",
  "ps2x_init": {
    "message0": "初始化 PS2 手柄 %1 ATT %2 CMD %3 DAT %4 CLK %5",
    "tooltip": "初始化 PS2（DualShock 2）手柄（通用库，硬件 SPI）。ATT 为片选；在支持 SPI 重映射的核心（如 ESP32）CMD/DAT/CLK 可任选 GPIO，在 SPI 焊盘固定的核心（如 micro:bit V2）必须接 P15(MOSI)/P14(MISO)/P13(SCK)。创乐博 MakeBit 板载 PS2 插座参考接线：ATT=P12、CMD=P15、DAT=P14、CLK=P13。放在“初始化”里使用；之后每轮循环会自动读取手柄数据。"
  },
  "ps2x_connected": {
    "message0": "手柄 %1 已连接",
