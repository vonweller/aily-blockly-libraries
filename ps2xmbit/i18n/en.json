{
  "toolbox_name": "PS2 Gamepad",
  "ps2x_init": {
    "message0": "init PS2 gamepad %1 ATT %2 CMD %3 DAT %4 CLK %5",
    "tooltip": "Initialize a PS2 (DualShock 2) gamepad (universal library, hardware SPI). ATT is the chip select; on cores that support SPI remapping (e.g. ESP32) CMD/DAT/CLK can be any GPIO, while on fixed-SPI-pad cores (e.g. micro:bit V2) they must be P15(MOSI)/P14(MISO)/P13(SCK). Reference wiring for the Chuanglebo MakeBit PS2 socket: ATT=P12, CMD=P15, DAT=P14, CLK=P13. Place it in setup; the gamepad is polled automatically every loop."
  },
  "ps2x_connected": {
    "message0": "gamepad %1 connected",
    "tooltip": "Whether the gamepad is connected and answering. When disconnected, sticks read 0 and all buttons read released; it reconfigures automatically after reconnecting."
  },
