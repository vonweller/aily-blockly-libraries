    {
      "id": "dht-field-variable",
      "abs": "dht_read_temperature($dht)",
      "expect": {
        "blockCounts": { "dht_read_temperature": 1 },
        "paths": [
          { "block": { "type": "dht_read_temperature" }, "path": "inputs.VAR", "absent": true }
        ],
        "variableBindings": [
          { "block": { "type": "dht_read_temperature" }, "field": "VAR", "name": "dht", "type": "DHT" }
        ]
      }
    },
    {
      "id": "core-logic-statement-body",
      "abs": "arduino_loop()\n    controls_if(logic_boolean(TRUE))\n        serial_println(Serial, text(\"ok\"))",
      "compile": {
        "board": "arduino:avr:uno",
        "artifacts": [".elf", ".hex"]
      },
      "expect": {
        "paths": [
          { "block": { "type": "controls_if" }, "path": "inputs.IF0.block.type", "equals": "logic_boolean" },
          { "block": { "type": "controls_if" }, "path": "inputs.DO0.block.type", "equals": "serial_println" }
        ],
        "codeIncludes": ["if (true)", "Serial.println(\"ok\")"]
      }
    },
    {
      "id": "core-loop-field-and-values",
      "abs": "arduino_loop()\n    controls_for($i, math_number(0), math_number(2), math_number(1))\n        serial_println(Serial, $i)",
      "expect": {
        "paths": [
          { "block": { "type": "controls_for" }, "path": "inputs.FROM.block.type", "equals": "math_number" },
          { "block": { "type": "controls_for" }, "path": "inputs.TO.block.type", "equals": "math_number" },
          { "block": { "type": "controls_for" }, "path": "inputs.BY.block.type", "equals": "math_number" },
          { "block": { "type": "controls_for" }, "path": "inputs.DO.block.type", "equals": "serial_println" }
        ],
        "variableBindings": [
          { "block": { "type": "controls_for" }, "field": "VAR", "name": "i" }
        ],
        "codeIncludes": ["for (", "Serial.println(i)"]
      }
    },
    {
