      "expect": {
        "paths": [
          { "block": { "type": "dht_init" }, "path": "fields.TYPE", "equals": "DHT11" },
          { "block": { "type": "dht_init" }, "path": "fields.PIN", "equals": "2" },
          { "block": { "type": "dht_init" }, "path": "fields.WIRE", "absent": true }
        ],
        "variableBindings": [
          { "block": { "type": "dht_read_temperature" }, "field": "VAR", "name": "dht", "type": "DHT" }
        ],
        "codeIncludes": ["DHT dht(2, DHT11);", "dht.begin();", "Serial.println(dht.readTemperature())"]
      }
    },
