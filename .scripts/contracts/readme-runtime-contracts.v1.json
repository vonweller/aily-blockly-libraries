        "variableBindings": [
          { "block": { "type": "dht_read_temperature" }, "field": "VAR", "name": "dht", "type": "DHT" }
        ],
        "codeIncludes": ["DHT20 dht(&Wire);", "Wire.begin();", "dht.getTemperature()"]
